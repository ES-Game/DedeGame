<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name="com.dede.dedegame.DedeApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Test"
        tools:targetApi="31">

        <activity
            android:name="com.dede.dedegame.presentation.splash.SplashActivity"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.home.HomeActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name=".presentation.chapter.ChapterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.story_cover.StoryCoverActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.login.LoginActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.register.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.profile.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.story_followed.StoryBookmarkActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.story_search.StorySearchActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.forget_password.ForgetPasswordActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.home.news.NewsDetailActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.home.game.GameDetailActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.home.fragments.main_game.game_list.GameListActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name="com.dede.dedegame.presentation.home.fragments.home_comic.story_list.StoryListActivity"
            android:exported="false"
            android:parentActivityName=".presentation.home.HomeActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <service android:name="com.dede.dedegame.cloudMessage.CloudNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>