<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_app_common">

    <com.dede.dedegame.presentation.widget.carouselView.CarouselView
        android:id="@+id/vpHomeTopBannerItm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:animateOnBoundary="true"
        app:fillColor="@color/white"
        app:indicatorMarginVertical="@dimen/_6sdp"
        app:pageColor="@android:color/transparent"
        app:radius="@dimen/_3sdp"
        app:slideInterval="5000"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3:1.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.dede.dedegame.presentation.common.IndicatorView
        android:id="@+id/idvHomeTopBannerItm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:indicator_view_icon_height="@dimen/_2sdp"
        app:indicator_view_icon_width="@dimen/_24sdp"
        app:indicator_view_type="slide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vpHomeTopBannerItm" />

</androidx.constraintlayout.widget.ConstraintLayout>
