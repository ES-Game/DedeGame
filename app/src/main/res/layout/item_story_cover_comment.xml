<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_app_common"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.dede.dedegame.presentation.widget.CircleImageView
        android:id="@+id/imageView2"
        android:layout_width="@dimen/size_icon_35dp"
        android:layout_height="@dimen/size_icon_35dp"
        android:src="@drawable/ic_placeholder_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_icon_58dp"
        android:layout_marginStart="@dimen/margin_between_part_in_item_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" >

        <TextView
            android:id="@+id/txtDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_300"
            android:layout_marginStart="@dimen/margin_between_part_in_item_12dp"
            android:textSize="@dimen/size_text_small"
            android:fontFamily="@font/montserrat_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TableRow
            android:id="@+id/containerContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtDateTime">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margin_between_part_in_item_8dp"
                android:paddingEnd="@dimen/margin_between_part_in_item_8dp"
                android:paddingTop="@dimen/margin_between_part_in_item_8dp"
                android:paddingBottom="@dimen/margin_between_part_in_item_8dp"
                android:background="@drawable/bg_corner_content_comment">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_text_medium"
                    android:text=""
                    android:fontFamily="@font/montserrat_semi_bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtDateTime" />

                <TextView
                    android:id="@+id/txtContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_text_small"
                    android:text=""
                    android:fontFamily="@font/montserrat_medium"
                    android:layout_marginTop="@dimen/margin_between_part_in_item_4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtName" />


            </LinearLayout>

        </TableRow>

        <TextView
            android:id="@+id/txtLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small_between_part_in_item"
            android:text="@string/story_cover_comment_like"
            android:background="@drawable/bg_selector_liked_btn"
            android:fontFamily="@font/montserrat_regular"
            android:paddingStart="@dimen/margin_between_part_in_item_15dp"
            android:paddingTop="@dimen/margin_small_between_part_in_item"
            android:paddingEnd="@dimen/margin_between_part_in_item_15dp"
            android:paddingBottom="@dimen/margin_small_between_part_in_item"
            android:textColor="@color/black"
            android:layout_marginStart="@dimen/margin_between_part_in_item_12dp"
            android:textSize="@dimen/size_text_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/containerContent" />

        <TextView
            android:id="@+id/txtReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small_between_part_in_item"
            android:layout_marginStart="@dimen/margin_small_between_part_in_item"
            android:text="@string/story_cover_comment_feedback"
            android:background="@drawable/bg_corner_orange_button"
            android:paddingStart="@dimen/margin_between_part_in_item_15dp"
            android:paddingTop="@dimen/margin_small_between_part_in_item"
            android:paddingEnd="@dimen/margin_between_part_in_item_15dp"
            android:paddingBottom="@dimen/margin_small_between_part_in_item"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="@dimen/size_text_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtLike"
            app:layout_constraintTop_toBottomOf="@+id/containerContent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtContent">

            <ImageView
                android:id="@+id/ivHeart"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:background="@drawable/ic_heart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@id/ivHeart"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <TextView
                android:id="@+id/tvCountLiked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text=""
                android:textColor="@color/black"
                android:fontFamily="@font/montserrat_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivHeart"
                app:layout_constraintTop_toTopOf="parent">

            </TextView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>