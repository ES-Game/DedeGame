<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/orange_300"
    android:paddingStart="@dimen/margin_left_right_layout"
    android:paddingEnd="@dimen/margin_left_right_layout"
    tools:ignore="MissingPrefix">

    <FrameLayout
        android:id="@+id/containerAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/padding_icon_toolbar"
        android:paddingBottom="@dimen/padding_icon_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/size_view_42dp"
            android:layout_height="@dimen/size_view_42dp"
            android:src="@drawable/ic_placeholder_avatar"
            app:civ_border_width="2dp"
            app:civ_border_color="@android:color/white"/>

    </FrameLayout>

    <TextView
        android:id="@+id/txtStartTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:gravity="start"
        android:textSize="@dimen/size_text_large_20sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/containerAvatar"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>